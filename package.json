{
  "name": "phone-access-app",
  "version": "1.0.0",
  "description": "Full phone access app with React Native, Supabase, and Discord bot",
  "private": true,
  "workspaces": [
    "server",
    "mobile",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:server": "npm run dev --workspace=server",
    "dev:mobile": "npm run start --workspace=mobile",
    "build:mobile": "npm run build --workspace=mobile",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:all": "npm run build:shared && npm run build:server",
    "start:server": "npm run start --workspace=server"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "railway": "^3.17.0"
  }
}
