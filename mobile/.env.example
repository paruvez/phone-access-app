# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# API Server (Discord Bot Server)
# For local development with ngrok: https://your-ngrok-url.ngrok-free.app
# For production: https://your-app.railway.app or https://your-app.onrender.com
API_BASE_URL=http://localhost:3000

# Optional: EAS Project ID for builds
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id